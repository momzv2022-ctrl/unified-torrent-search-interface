  {
    "name": "knaben-down-piratebay-carries-it",
    "why": "The whole point of a second broad engine: knaben refuses, and a general search still answers instead of collapsing to films and anime.",
    "settings": { "engines": ["knaben", "piratebay", "yts", "nyaa"] },
    "routes": {
      "https://api.knaben.org/v1": { "status": 429 },
      "https://apibay.org/q.php": { "fixture": "piratebay.json" },
      "https://yts.bz/api/v2/list_movies.json": { "fixture": "yts.json" },
      "https://nyaa.si/?page=rss": { "fixture": "nyaa.xml" }
    },
    "query": { "q": "big buck bunny" }
  },
  {
    "name": "piratebay",
    "why": "Every field a string, two categories mapped and one left to the name classifier, and their one-row 'no results' sentinel dropped.",
    "settings": { "engines": ["piratebay"] },
    "routes": { "https://apibay.org/q.php": { "fixture": "piratebay.json" } },
    "query": { "q": "big buck bunny" }
  },
  {
    "name": "two-broad-engines-merge",
    "why": "The point of carrying two broad indexes: the same release from both collapses to one row, and knaben going dark costs coverage rather than everything.",
    "settings": { "engines": ["knaben", "piratebay"] },
    "routes": {
      "https://api.knaben.org/v1": { "fixture": "knaben.json" },
      "https://apibay.org/q.php": { "fixture": "piratebay.json" }
    },
    "query": { "q": "big buck bunny" }
  },
  {
    "name": "broad-engine-down-narrow-survives",
    "why": "knaben refusing while piratebay answers: the search still works, which is the whole reason the second broad engine exists.",
    "settings": { "engines": ["knaben", "piratebay", "yts"] },
    "routes": {
      "https://api.knaben.org/v1": { "status": 403 },
      "https://apibay.org/q.php": { "fixture": "piratebay.json" },
