  {
    "name": "query-gate-drops-what-the-engine-ignored",
    "why": "eztvx.to answers a Keywords it cannot match with the newest episodes on the site. None of them answer the query, so none of them are results.",
    "settings": { "engines": ["eztvx"], "query_match": "terms" },
    "routes": { "https://eztvx.to/api/get-torrents": { "fixture": "eztvx-latest.json" } },
    "query": { "q": "micheal jackson" }
  },
  {
    "name": "query-gate-keeps-the-rows-that-answer",
    "why": "The same ignored answer, asked something one of its rows does happen to match: the gate narrows, it does not empty.",
    "settings": { "engines": ["eztvx"], "query_match": "terms" },
    "routes": { "https://eztvx.to/api/get-torrents": { "fixture": "eztvx-latest.json" } },
    "query": { "q": "spiderman" }
  },
  {
    "name": "query-gate-tolerates-a-dropped-stop-word",
    "why": "`the` is typed and not shipped. Requiring it would delete the row that was asked for.",
    "settings": { "engines": ["eztvx"], "query_match": "terms" },
    "routes": { "https://eztvx.to/api/get-torrents": { "fixture": "eztvx-latest.json" } },
    "query": { "q": "the public domain show" }
  },
  {
    "name": "query-gate-off-returns-what-the-engine-said",
    "why": "The escape hatch for an upstream that does its own fuzzy matching: same request, no gate, every row survives.",
    "settings": { "engines": ["eztvx"], "query_match": "off" },
    "routes": { "https://eztvx.to/api/get-torrents": { "fixture": "eztvx-latest.json" } },
    "query": { "q": "micheal jackson" }
  },
  {
    "name": "query-gate-forgives-one-keystroke",
    "why": "A misspelled query against an engine forgiving enough to have answered it anyway: the real row survives, the newest-episode filler beside it does not.",
    "settings": { "engines": ["eztvx"], "query_match": "terms" },
    "routes": { "https://eztvx.to/api/get-torrents": { "fixture": "eztvx-misspelled.json" } },
    "query": { "q": "micheal jackson" }
  },
  {
    "name": "query-gate-does-not-touch-a-browse",
    "why": "An empty q is browsing, and the term standing in for it is this server's invention. A 720p row survives a browse for 1080p because the client never asked for either.",
    "settings": { "engines": ["eztvx"], "query_match": "terms", "browse_queries": ["1080p"] },
    "routes": { "https://eztvx.to/api/get-torrents": { "fixture": "eztvx-latest.json" } },
    "query": { "q": "" }
  }
