__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Third-party plugin code is fetched at runtime and must never be committed.
# The default runtime dir lives in /tmp; this covers the case where an operator
# points UTSI_RUNTIME_DIR at the working tree.
/runtime/

# Generated by `utsi probe` and `utsi registry-update`; only registry.json and
# PLUGINS.md are tracked.
probe-report.json
probe-report.md
registry-changes.json
.env

# start.sh's working dir: the generated API key, the pid, the log, and
# cloudflared if a tunnel was ever asked for.
.utsi/

# Node's install directory, for the two dev-only tools that need one
# (playwright, for the setup-page check). The Worker itself has no dependencies.
node_modules/

# Built by `node worker/tools/build.mjs` and published by CI to GitHub Pages.
# The artifact is a copy of worker/src/worker.js, so there is nothing here that
# is not already in the repository.
/site/

# FUSE leftovers from editing over the desktop bridge. Not ours, not deletable
# from that side; see _to_delete/.
.fuse_hidden*
_to_delete/

# What the README's curl line leaves in the working tree when it is run from
# here. The Worker lives in worker/src/worker.js; a copy at the root was once
# committed by accident.
/worker.js
