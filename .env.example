# Every setting has a working default; nothing here is required.
# Export any of these before ./start.sh and they win over its defaults.

# --- access ----------------------------------------------------------------
# Unset: a key is generated on first boot, printed in the logs, and kept so a
# restart does not invalidate the one you already pasted into a client.
# start.sh keeps it in .utsi/api-key next to the checkout; `utsi serve` on its
# own uses UTSI_KEY_FILE below. Delete that file to roll the key.
#UTSI_API_KEY=
#UTSI_KEY_FILE=~/.utsi/api-key
# Only for a LAN deployment. An open scraper proxy on a public URL gets abused.
#UTSI_ALLOW_ANONYMOUS=0
#UTSI_RATE_LIMIT_PER_MIN=30

# Only needed when a web page on another domain calls the API; native TSP
# clients never send an Origin. Comma-separated, named origins only. There is
# no wildcard on purpose. Remember a browser frontend exposes the API key to
# whoever opens devtools.
#UTSI_CORS_ORIGINS=https://my-frontend.netlify.app

# Behind a tunnel/CDN/reverse proxy every request arrives from 127.0.0.1, so
# anonymous callers share one rate-limit bucket. Name the header carrying the
# real client IP to separate them. ONLY set this when something in front really
# sets that header. Otherwise clients forge it and bypass the limit.
#UTSI_TRUSTED_PROXY_HEADER=cf-connecting-ip

# Serve the single-file browser client at `/`. Set 0 for a bare API. The page
# holds the API key in the browser's local storage, which suits a personal
# instance and not a shared one.
#UTSI_UI=1

# --- serving ---------------------------------------------------------------
#UTSI_HOST=0.0.0.0
#UTSI_PORT=7860

# --- the fan-out -----------------------------------------------------------
#UTSI_REQUEST_DEADLINE_S=8      # answer with whatever finished by then
#UTSI_ENGINE_TIMEOUT_S=6
#UTSI_MAX_ENGINES_PER_REQUEST=12
#UTSI_CACHE_TTL_S=300           # also what makes paging coherent
#UTSI_BREAKER_FAILURES=3
#UTSI_BREAKER_OPEN_S=900

# Stop waiting for stragglers once N engines have answered with
# EARLY_EXIT_ROWS_FACTOR x the requested page in rows. Big latency win, but two
# requests for one query can stop on different engine subsets, so paging with
# `offset` stops being a coherent sequence. 0 disables.
#UTSI_EARLY_EXIT_ENGINES=0
#UTSI_EARLY_EXIT_ROWS_FACTOR=3

# Restrict to specific engines, e.g. the CI-tested official ones only.
#UTSI_ENGINES=piratebay,torrentscsv,eztv,solidtorrents

# Provision only the best N plugins by health score instead of every enabled
# one. Boot fetches, scans and byte-compiles each, so this is the main lever
# on start-up time and disk on a small device. 0 = all.
#UTSI_MAX_PLUGINS=0

# --- the datacenter-IP problem ---------------------------------------------
# The single most effective mitigation: route the whole fan-out through your own
# exit node. Read straight through to upstream's `helpers.enable_socks_proxy()`.
#UTSI_SOCKS_PROXY=socks5h://127.0.0.1:9050

# --- semantics -------------------------------------------------------------
# Empty `q` is legal in TSP. `browse` answers with a rotating generic query;
# `empty` answers 200 with no rows. Never a 400.
#UTSI_EMPTY_QUERY_MODE=browse
#UTSI_BROWSE_QUERIES=2160p,1080p,x265

# Whether a row has to answer `q` to be returned. `terms` wants every word of
# the query in the release name; `off` returns whatever the engines said. On by
# default because engines lie by omission — a site that cannot match what it was
# asked answers with its newest uploads rather than with nothing, and a fan-out
# cannot tell that from a search that went well. Turn it off only in front of an
# index doing its own fuzzy or synonym matching, where a literal gate here would
# delete the answers it found.
#UTSI_QUERY_MATCH=terms

# --- plugins ---------------------------------------------------------------
# Private-site plugins need your credentials. Off by default. Carrying them
# would mean editing the plugin, which is not a supported path.
#UTSI_INCLUDE_PRIVATE=0
#UTSI_RUNTIME_DIR=/tmp/utsi-runtime
#UTSI_REGISTRY=registry.json

# --- sandbox ---------------------------------------------------------------
#UTSI_RLIMIT_AS_MB=512
#UTSI_RLIMIT_CPU_S=20
#UTSI_RLIMIT_NOFILE=256
#UTSI_RLIMIT_FSIZE_MB=32
